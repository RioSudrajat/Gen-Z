GENZ_ENVIRONMENT=demo
GENZ_APP_ORIGIN=http://localhost:3001
# Origin marketing untuk tautan kembali dari halaman login. Isi domain saat deploy.
GENZ_MARKETING_ORIGIN=http://localhost:4321
# Proof EVM pada Base Sepolia. Transaksi finansial tetap belum diaktifkan.
GENZ_EVM_CHAIN_ID=84532
# Opsional: RPC server-only untuk verifikasi signature smart account (1271/6492).
# EOA login tidak memerlukan RPC. Jangan menaruh credential ini dalam NEXT_PUBLIC_*.
GENZ_BASE_RPC_URL=
# npm run setup:platform menyiapkan database lokal dan URL ini.
DATABASE_URL=
# Object storage dan credential tetap server-only, vendor belum dipilih.
PRIVATE_STORAGE_BUCKET=
