---
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import landscape from '../../assets/infrastructure-landscape.jpg';
---
<section id="connect" class="landing-section closing-section" aria-labelledby="connect-title">
  <div class="page-container">
    <div class="closing-banner">
      <Image
        src={landscape}
        alt="Solar energy infrastructure landscape"
        class="closing-banner-img"
        loading="lazy"
        decoding="async"
        width="1920"
        widths={[480, 800, 1280, 1920]}
        sizes="(min-width: 1284px) 1180px, calc(100vw - 40px)"
        format="webp"
        quality={80}
      />
      <div class="closing-card">
        <h2 id="connect-title" class="closing-heading" tabindex="-1">
          Earn from real<br class="closing-br" />infrastructure
        </h2>
        <p class="closing-copy">
          Review assets, monitor performance, and earn revenue generated by real-world energy infrastructure.
        </p>
        <div class="closing-cta-box">
          <a class="closing-pill-button" href={site.platformAuthUrl}>
            <span>Get started now</span>
            <svg class="closing-arrow-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33334M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
