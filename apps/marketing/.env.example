# Isi origin marketing produksi saat domain final tersedia.
# Mengaktifkan canonical URL, social image absolut, Organization JSON-LD dan sitemap.
PUBLIC_SITE_ORIGIN=

# URL origin platform saja, tanpa path, query, credential, atau trailing endpoint.
# Kosong: marketing tetap berjalan dengan draft contact dan halaman app unavailable.
# Isi sesudah wallet auth platform tersedia. Inquiry diaktifkan secara terpisah.
# Endpoint inquiry: POST <origin>/api/v1/inquiries, receipt { "reference": "..." }.
# Platform harus mengizinkan origin marketing lewat CORS dan menangani idempotency.
PUBLIC_PLATFORM_ORIGIN=
PUBLIC_PLATFORM_INQUIRIES_ENABLED=false
